{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "crona": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "type": "component"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "crona",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "fileReplacements": [
                {
                  "replace": "src/app/nucleo/demonstracao.build.ts",
                  "with": "src/app/nucleo/demonstracao.build.demo.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "crona:build:production"
            },
            "development": {
              "buildTarget": "crona:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": [
              "src/app/**/*.ts"
            ],
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/**/*.build*.ts"
            ],
            "coverageReporters": [
              "html",
              "text-summary",
              "json-summary"
            ],
            "coverageThresholds": {
              "lines": 25,
              "branches": 45,
              "functions": 25,
              "statements": 25
            }
          }
        }
      }
    }
  }
}
