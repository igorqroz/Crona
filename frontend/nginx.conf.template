# Configuração do nginx que serve o Crona (Fase 9).
# É um MODELO: ao subir, o nginx troca ${API_URL} pelo valor da variável de ambiente.

server {
    listen 80;
    root /usr/share/nginx/html;

    # /api/... vai para a API (o mesmo papel do proxy.conf.json no `npm start`).
    # Como o navegador fala só com este servidor, não precisa de CORS.
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Os arquivos do Angular têm um "hash" no nome (main-NCD7IJRT.js): podem ficar em cache por 1 ano.
    location ~* \.(js|css|woff2?|ico|png|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: qualquer outra rota (/inicio, /aprovacoes...) devolve o index.html e o roteador do
    # Angular decide a tela. Sem isto, um F5 em /aprovacoes daria 404.
    location / {
        try_files $uri $uri/ /index.html;
        # O index.html nunca fica em cache: assim uma versão nova chega na hora.
        add_header Cache-Control "no-cache";
    }
}
