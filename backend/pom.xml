<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>br.com.crona</groupId>
	<artifactId>crona-api</artifactId>
	<version>1.2.0</version>
	<name>crona-api</name>
	<description>API do Crona - Gestao de Ferias</description>
	<properties>
		<java.version>21</java.version>
		<!-- Vazio de propósito: o surefire (mais abaixo) completa com o agente do Mockito -->
		<argLine></argLine>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Fase 9: /actuator/health, o "estou vivo?" que o Docker e a hospedagem consultam. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
			Fase 8a: JasperReports gera o PDF do aviso de férias a partir de um modelo (.jrxml).
			Na versão 7, a exportação para PDF virou um artefato separado (jasperreports-pdf).
		-->
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports</artifactId>
			<version>7.0.3</version>
		</dependency>
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports-pdf</artifactId>
			<version>7.0.3</version>
		</dependency>
		<!-- Fontes DejaVu "embutidas" no PDF: negrito de verdade e acentos garantidos em qualquer computador. -->
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports-fonts</artifactId>
			<version>7.0.3</version>
		</dependency>
		<!--
			Fase 9: o compilador do Eclipse (JDT) para as expressões do .jrxml. Sem ele, o JasperReports
			usa o javac, que NÃO enxerga as bibliotecas de dentro do .jar do Spring Boot (BOOT-INF/lib):
			a API subia no "mvnw spring-boot:run", mas quebrava dentro do Docker.
		-->
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports-jdt</artifactId>
			<version>7.0.3</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Spring Security: login, proteção das rotas e permissões (já inclui o BCrypt). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Suporte a JWT: o Spring confere sozinho o token de cada requisição. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ferramentas de teste do Spring Security, como simular um usuário com token -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!-- Versionamento: grava a versão (a <version> lá em cima) em META-INF/build-info.properties.
					     O /actuator/info lê de lá. -->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<!-- Sem a hora do build: com builds reproduzíveis ela sairia como 1980. -->
							<time>off</time>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Descobre o caminho do jar do Mockito (vira a propriedade ${org.mockito:mockito-core:jar}) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Carrega o Mockito como agente da JVM nos testes, como a documentação dele pede.
			     Sem isto, versões futuras do Java vão bloquear o Mockito. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<!-- COBERTURA dos testes (JaCoCo): mede quais linhas e caminhos (if/else) do código os
			     testes executaram. Roda junto com ./mvnw test e gera o relatório em
			     target/site/jacoco/index.html (abra no navegador).
			     Como funciona: o "prepare-agent" coloca um agente na JVM dos testes (ele entra no
			     @{argLine} do surefire, acima) que anota cada linha executada; o "report" transforma
			     essas anotações no relatório. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.14</version>
				<configuration>
					<excludes>
						<!-- Só o main() que sobe o Spring: não tem lógica para testar. -->
						<exclude>br/com/crona/CronaApiApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>preparar-agente</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>relatorio</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!-- A "catraca" da cobertura: o build FALHA se a cobertura cair abaixo destes
					     mínimos (um pouco abaixo do que temos hoje). Assim, código novo sem teste
					     não entra sem ninguém ver. Fica na fase "verify" (./mvnw verify, que o CI
					     roda) e não no "test": rodar um teste só na sua máquina não esbarra nela.
					     Quando a cobertura subir, suba os números junto. -->
					<execution>
						<id>minimo-de-cobertura</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.90</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
